        "l2p_flags",
        "quality_level",
        "satellite_zenith_angle",
        "sses_bias",
        "sses_standard_deviation",
        "sst_dtime",
        "sst_front_position",
        "sst_gradient_magnitude",
        "wind_speed"
      ]
    }
  }
}
