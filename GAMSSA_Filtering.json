{
  "metadata": {
    "mission": "GAMSSA",
    "product": "GAMSSA",
    "config_type": "filtering",
    "schema_version": "1.0"
  },
  "filters": {
    "pixel_filter": [
      {
        "target_var": "analysed_sst",
        "criteria_var": "mask",
        "operator": "equal-to",
        "threshold": "2",
        "target_value": "nan",
        "level": "all"
      },
      {
        "target_var": "analysed_sst",
        "criteria_var": "mask",
        "operator": "equal-to",
        "threshold": "8",
        "target_value": "nan",
        "level": "all"
      },
      {
        "target_var": "analysed_sst",
        "criteria_var": "analysis_error",
        "operator": "greater-than-or-equal-to",
        "threshold": "0.99",
        "target_value": "nan",
        "level": "all"
      },
      {
        "target_var": "sea_ice_fraction",
        "criteria_var": "mask",
        "operator": "not-equal-to",
        "threshold": "1",
        "criteria_var_AND": "mask",
        "operator_AND": "not-equal-to",
        "threshold_AND": "8",
        "target_value": "nan",
        "level": "all"
      }
    ],
    "variable_exclusion": {
      "excluded_variables": [
        "analysis_error",
        "mask",
        "analysed_sst",
        "sea_ice_fraction"
      ]
    }
  }
}
